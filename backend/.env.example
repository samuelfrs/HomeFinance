# Configurações do Servidor
PORT=5090
NODE_ENV=development

# Conexão com o Banco de Dados (PostgreSQL)
# Para rodar com o docker-compose local na porta 5433:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/homefinance_db?schema=public"

# Para conexão com Supabase, Neon ou Railway (basta substituir a URL acima):
# DATABASE_URL="postgresql://postgres.[REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"
